# Template only: replace every REPLACE_WITH_* value before use.
# Production must use separate credentials from your secret manager/environment.
# ASP.NET Core does not load this file automatically. See docs/verification/GIT_SECURITY_2026-10-27.md.
# Docker Compose reads an untracked local .env; do not commit that file.
POSTGRES_DB=culinary_blog
POSTGRES_USER=REPLACE_WITH_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# Backend
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=culinary_blog;Username=REPLACE_WITH_DATABASE_USER;Password=REPLACE_WITH_DATABASE_PASSWORD
ConnectionStrings__Redis=localhost:6379
Jwt__Issuer=CulinaryBlog
Jwt__Audience=CulinaryBlog
Jwt__Secret=REPLACE_WITH_YOUR_OWN_SECRET
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7
Google__ClientId=
Google__ClientSecret=
Minio__Endpoint=localhost:9000
FileStorage__Provider=Minio
Minio__AccessKey=REPLACE_WITH_YOUR_OWN_SECRET
Minio__SecretKey=REPLACE_WITH_YOUR_OWN_SECRET
Minio__Bucket=culinary-blog
Minio__PublicBaseUrl=http://localhost:9000/culinary-blog
Minio__PublicRead=true
Seq__ServerUrl=http://localhost:5341
Smtp__Host=localhost
Smtp__Port=1025
FileUpload__MaxFileSizeBytes=5242880
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://127.0.0.1:3000
Cors__Production__AllowedOrigins__0=https://your-domain.com
RateLimiting__AuthLogin__PermitLimit=10
RateLimiting__AuthLogin__WindowSeconds=60
RateLimiting__AuthLogin__QueueLimit=0

# Frontend
