# Backend
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5434;Database=culinary_blog;Username=admin;Password=admin
ConnectionStrings__Redis=localhost:6379
Jwt__Issuer=CulinaryBlog
Jwt__Audience=CulinaryBlog
Jwt__Secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7
Google__ClientId=
Google__ClientSecret=
Minio__Endpoint=localhost:9000
Minio__AccessKey=CHANGE_ME
Minio__SecretKey=CHANGE_ME
Minio__Bucket=culinary-blog
Seq__ServerUrl=http://localhost:5341
# Docker Compose SMTP for direct delivery to new users.
# Copy the SMTP_* lines into a root .env file and replace CHANGE_ME values.
# Keep the root .env file private; Docker Compose reads it automatically.
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=CHANGE_ME_EMAIL_ADDRESS
SMTP_PASSWORD=CHANGE_ME_APP_PASSWORD
SMTP_FROM_ADDRESS=CHANGE_ME_EMAIL_ADDRESS
SMTP_FROM_NAME=Culinary Blog
WELCOME_EMAIL_APPLICATION_URL=http://localhost:3000

# When running dotnet run outside Docker, .env is not loaded automatically.
# Set Smtp__Host, Smtp__Port, Smtp__UseSsl, Smtp__UserName,
# Smtp__Password and Smtp__FromAddress as process environment variables
# or .NET User Secrets. Do not put their real values in this example file.

# Frontend
AUTH_SECRET=CHANGE_ME
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
