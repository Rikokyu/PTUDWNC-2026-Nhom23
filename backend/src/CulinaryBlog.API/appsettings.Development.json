{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "127.0.0.1:6380"
  },
  "Jwt": {
    "Issuer": "CulinaryBlog",
    "Audience": "CulinaryBlog",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "FileStorage": {
    "PublicBasePath": "/uploads"
  },
  "Hangfire": {
    "Enabled": true,
    "DashboardEnabled": false
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "FromAddress": "no-reply@culinary.local",
    "FromName": "Culinary Blog"
  },
  "WelcomeEmail": {
    "ApplicationUrl": "http://localhost:3000",
    "RequireActivation": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "Bucket": "culinary-blog",
    "PublicBaseUrl": "http://localhost:9000/culinary-blog",
    "PublicRead": true,
    "UseSSL": false
  }
}
