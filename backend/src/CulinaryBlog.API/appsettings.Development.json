{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=culinary_blog;Username=admin;Password=admin"
  },
  "Jwt": {
    "Issuer": "CulinaryBlog",
    "Audience": "CulinaryBlog",
    "Secret": "culinary-blog-development-secret-key-2026-only",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "FileStorage": {
    "PublicBasePath": "/uploads"
  },
  "Hangfire": {
    "Enabled": true,
    "DashboardEnabled": false
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "FromAddress": "no-reply@culinary.local",
    "FromName": "Culinary Blog"
  },
  "WelcomeEmail": {
    "ApplicationUrl": "http://localhost:3000",
    "RequireActivation": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
